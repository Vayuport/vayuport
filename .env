# Only needed if you deploy api/early-access.js as a serverless function
# and switch assets/js/main.js to call '/api/early-access' instead of
# calling Web3Forms directly. Copy this file to `.env`, fill in the real
# value, and set the same variable in your hosting platform's dashboard —
# never commit the real .env file.

WEB3FORMS_ACCESS_KEY=b53eff0d-3878-4f49-91af-e72dfce5311f

